# Copy to .env (never committed) and adjust.
FREETUBE_S3_BUCKET=freetube-7k3q9x
AWS_REGION=eu-west-3
# Generate with: docker compose run --rm -it api python -m freetube.hash_password
# Keep the single quotes: compose interpolates `$`, and argon2 hashes are full of it.
FREETUBE_PASSWORD_HASH='$argon2id$...'
