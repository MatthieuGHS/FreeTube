<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone by cloud backup or device transfer: the token ciphertext is useless
     without its Keystore key, and the library is re-synced from the server (M5). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
