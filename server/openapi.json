            "title": "Status",
            "type": "string"
          },
          "thumb_put_url": {
            "title": "Thumb Put Url",
            "type": "string"
          }
        },
        "required": [
          "status",
          "audio_put_url",
          "thumb_put_url"
        ],
        "title": "UploadPending",
        "type": "object"
      },
      "UploadReady": {
        "properties": {
          "status": {
            "const": "ready",
