          "payload"
        ],
        "title": "UpdateTrackOp",
        "type": "object"
      },
      "UpdateTrackPayload": {
        "additionalProperties": false,
        "properties": {
          "artist": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Artist",
            "type": "string"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "video_id": {
            "pattern": "^[A-Za-z0-9_-]{11}$",
            "title": "Video Id",
            "type": "string"
          }
        },
        "required": [
          "video_id",
          "title",
          "artist"
        ],
        "title": "UpdateTrackPayload",
        "type": "object"
      },
      "UploadIn": {
        "additionalProperties": false,
        "properties": {
          "artist": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Artist",
            "type": "string"
          },
          "audio_ext": {
            "enum": [
              "m4a",
              "webm",
              "opus"
            ],
            "title": "Audio Ext",
            "type": "string"
          },
          "audio_mime": {
            "pattern": "^audio/[a-z0-9.+-]{1,40}$",
            "title": "Audio Mime",
            "type": "string"
          },
          "duration_s": {
            "maximum": 86400.0,
            "minimum": 0.0,
            "title": "Duration S",
            "type": "integer"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "artist",
          "duration_s",
          "audio_ext",
          "audio_mime"
        ],
        "title": "UploadIn",
        "type": "object"
      },
      "UploadPending": {
        "properties": {
          "audio_put_url": {
            "title": "Audio Put Url",
