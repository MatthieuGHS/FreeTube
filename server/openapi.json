            "type": "string"
          },
          "deleted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deleted At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "items": {
            "items": {
              "type": "string"
            },
            "title": "Items",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rev": {
            "title": "Rev",
            "type": "integer"
          },
          "source_youtube_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Youtube Id"
          }
        },
        "required": [
          "id",
          "name",
          "source_youtube_id",
          "items",
          "rev",
          "deleted_at",
          "created_at"
        ],
        "title": "Playlist",
        "type": "object"
      },
      "PlaylistCreate": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "items": {
            "items": {
              "pattern": "^[A-Za-z0-9_-]{11}$",
              "type": "string"
            },
            "maxItems": 5000,
            "title": "Items",
            "type": "array"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "source_youtube_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_-]{2,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Youtube Id"
          }
        },
        "required": [
          "name",
          "items",
          "id"
        ],
        "title": "PlaylistCreate",
        "type": "object"
      },
      "PlaylistIn": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "pattern": "^[A-Za-z0-9_-]{11}$",
              "type": "string"
            },
            "maxItems": 5000,
            "title": "Items",
            "type": "array"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "source_youtube_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_-]{2,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Youtube Id"
          }
        },
        "required": [
          "name",
          "items"
        ],
        "title": "PlaylistIn",
        "type": "object"
      },
      "SyncPull": {
        "description": "Changes with rev > since, tombstones included. Tracks still being uploaded are never\nlisted: a track appears when it becomes ready (that transition bumps its rev).",
        "properties": {
          "cursor": {
            "title": "Cursor",
            "type": "integer"
          },
          "playlists": {
            "items": {
              "$ref": "#/components/schemas/Playlist"
            },
            "title": "Playlists",
            "type": "array"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/Track"
            },
            "title": "Tracks",
            "type": "array"
          }
        },
        "required": [
          "tracks",
          "playlists",
          "cursor"
        ],
        "title": "SyncPull",
        "type": "object"
      },
      "Track": {
        "properties": {
          "artist": {
            "title": "Artist",
            "type": "string"
          },
          "audio_ext": {
            "title": "Audio Ext",
            "type": "string"
          },
          "audio_mime": {
            "title": "Audio Mime",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "deleted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deleted At"
          },
          "duration_s": {
            "title": "Duration S",
            "type": "integer"
          },
          "rev": {
            "title": "Rev",
            "type": "integer"
          },
          "status": {
            "enum": [
              "pending_upload",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "video_id": {
            "title": "Video Id",
            "type": "string"
          }
        },
        "required": [
          "video_id",
          "title",
          "artist",
          "duration_s",
          "audio_ext",
          "audio_mime",
          "status",
          "rev",
          "deleted_at",
          "created_at"
        ],
        "title": "Track",
        "type": "object"
      },
      "TrackPatch": {
        "additionalProperties": false,
        "properties": {
          "artist": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Artist",
            "type": "string"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "artist"
        ],
        "title": "TrackPatch",
        "type": "object"
      },
      "UpdateTrackOp": {
        "additionalProperties": false,
        "properties": {
          "op_id": {
            "format": "uuid",
            "title": "Op Id",
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/UpdateTrackPayload"
          },
          "type": {
            "const": "update_track",
