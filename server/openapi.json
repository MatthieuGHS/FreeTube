          "payload": {
            "$ref": "#/components/schemas/DeletePlaylistPayload"
          },
          "type": {
            "const": "delete_playlist",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "op_id",
          "type",
          "payload"
        ],
        "title": "DeletePlaylistOp",
        "type": "object"
      },
      "DeletePlaylistPayload": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "DeletePlaylistPayload",
        "type": "object"
      },
      "DeleteTrackOp": {
        "additionalProperties": false,
        "properties": {
          "op_id": {
            "format": "uuid",
            "title": "Op Id",
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/DeleteTrackPayload"
          },
          "type": {
            "const": "delete_track",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "op_id",
          "type",
          "payload"
        ],
        "title": "DeleteTrackOp",
        "type": "object"
      },
      "DeleteTrackPayload": {
        "additionalProperties": false,
        "properties": {
          "video_id": {
            "pattern": "^[A-Za-z0-9_-]{11}$",
