        ],
        "title": "DeviceCreated",
        "type": "object"
      },
      "DeviceIn": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "DeviceIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginIn": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "Me": {
        "properties": {
          "kind": {
            "enum": [
              "session",
              "device"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "Me",
        "type": "object"
      },
      "OpsIn": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "ops": {
            "items": {
              "discriminator": {
                "mapping": {
                  "delete_playlist": "#/components/schemas/DeletePlaylistOp",
                  "delete_track": "#/components/schemas/DeleteTrackOp",
                  "update_track": "#/components/schemas/UpdateTrackOp",
                  "upsert_playlist": "#/components/schemas/UpsertPlaylistOp"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/UpsertPlaylistOp"
                },
                {
                  "$ref": "#/components/schemas/DeletePlaylistOp"
                },
                {
                  "$ref": "#/components/schemas/UpdateTrackOp"
                },
                {
                  "$ref": "#/components/schemas/DeleteTrackOp"
                }
              ]
            },
            "maxItems": 500,
            "title": "Ops",
            "type": "array"
          }
        },
        "required": [
          "ops"
        ],
        "title": "OpsIn",
        "type": "object"
      },
      "OpsOut": {
        "description": "200 means the whole batch is committed: the client deletes every op it sent.",
        "properties": {
          "acked": {
            "title": "Acked",
            "type": "integer"
          }
        },
        "required": [
          "acked"
        ],
        "title": "OpsOut",
        "type": "object"
      },
      "Playlist": {
        "properties": {
          "created_at": {
            "format": "date-time",
